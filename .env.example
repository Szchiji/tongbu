# ============================================================
# tongbu 机器人环境变量配置示例
# 复制此文件为 .env 并填写对应的值
# ============================================================

# ============================================================
# 通用配置（两种模式均需要）
# ============================================================

# 主人用户 ID（通过 @userinfobot 获取）
OWNER_ID=123456789

# Web 管理后台访问地址（Railway 部署后从控制台获取）
BASE_URL=https://your-app.up.railway.app

# Flask Session 密钥（可选，留空则自动生成随机密钥）
# 建议在生产环境中手动设置一个随机字符串
SECRET_KEY=

# Redis 数据库连接（Railway 部署时自动注入，本地测试可留空）
# 留空时机器人回退到使用本地 JSON 文件存储数据
REDIS_URL=

# HTTP 服务端口（Railway 部署时自动注入，无需手动设置）
PORT=8080

# ============================================================
# 模式一：Bot 账户模式（默认，推荐大多数用户使用）
# ============================================================
# 优点：配置简单、安全稳定
# 缺点：无法同步其他机器人发送的消息（Telegram 平台限制）
#
# 配置步骤：
# 1. 通过 @BotFather 创建机器人，获取 BOT_TOKEN
# 2. 填写 BOT_TOKEN，留空 SESSION_STRING
# ============================================================

# 机器人 Token（@BotFather 获取）
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram API 凭证（可选，默认使用 Pyrogram 内置 API）
# 如需生产环境稳定性，建议前往 https://my.telegram.org 获取自己的 API 凭证
API_ID=
API_HASH=

# ============================================================
# 模式二：用户账户模式（高级配置，可同步其他机器人消息）
# ============================================================
# 优点：可以接收并同步群内其他机器人发送的消息
# 缺点：需要使用个人账号，存在封号风险
#
# 配置步骤：
# 1. 访问 https://my.telegram.org 获取 API_ID 和 API_HASH
# 2. 本地运行以下 Python 脚本生成 SESSION_STRING：
#
#    from pyrogram import Client
#    with Client("tmp", api_id=YOUR_API_ID, api_hash=YOUR_API_HASH) as app:
#        print(app.export_session_string())
#
# 3. 将 BOT_TOKEN 留空（不设置），填写 API_ID、API_HASH、SESSION_STRING
# 4. 参见 USER_ACCOUNT_MODE.md 了解完整配置方法
#
# ⚠️  警告：请勿使用主账号，建议使用专用小号，存在封号风险
# ============================================================

# 用于用户账户模式的 Pyrogram Session 字符串
# 使用用户账户模式时：填写此值，同时将 BOT_TOKEN 留空
SESSION_STRING=
